<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SerpentsEyes.App.ViewModels"
        xmlns:controls="using:SerpentsEyes.App.Controls"
        xmlns:gd="using:SerpentsEyes.Core.GameData"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SerpentsEyes.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Serpent's Eyes"
        Width="1280" Height="800" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg0}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ Custom title bar (Windows only; hidden elsewhere in code-behind) ═══ -->
        <Grid Grid.Row="0" x:Name="CustomTitleBar" Height="36"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              Background="{StaticResource Bg1}"
              WindowDecorationProperties.ElementRole="TitleBar">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" Margin="14,0,18,0"
                        VerticalAlignment="Center">
                <Canvas Width="20" Height="12" VerticalAlignment="Center">
                    <Path Stroke="{StaticResource Gold}" StrokeThickness="1.3"
                          Data="M 1,6 Q 10,-2.5 19,6 Q 10,14.5 1,6 Z" />
                    <Ellipse Canvas.Left="8" Canvas.Top="2" Width="4" Height="8"
                             Fill="{StaticResource Gold}" />
                </Canvas>
                <TextBlock Text="Serpent's Eyes" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" Foreground="{StaticResource Text}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ComboBox Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                      FontSize="12" Padding="10,4"
                      WindowDecorationProperties.ElementRole="User"
                      Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}" />

            <Button Grid.Column="2" VerticalAlignment="Center"
                    Margin="8,0,0,0" Padding="10,4" FontSize="12"
                    WindowDecorationProperties.ElementRole="User"
                    Background="Transparent" Foreground="{StaticResource TextMuted}"
                    Click="Reload_Click" ToolTip.Tip="Re-read the save file from disk">
                ⟳ Reload
            </Button>

            <Button Grid.Column="3" VerticalAlignment="Center"
                    Margin="4,0,8,0" Padding="10,4" FontSize="12"
                    WindowDecorationProperties.ElementRole="User"
                    Background="Transparent" Foreground="{StaticResource TextMuted}"
                    Click="Open_Click" ToolTip.Tip="Open a .sav file from anywhere (or drop one on the window)">
                Open…
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,14,0" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Reading…" FontSize="11" Foreground="{StaticResource Gold}"
                           VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding FileInfoText}" FontSize="11"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Vector caption glyphs: the Windows glyphs 🗕 🗖 🗙 render as tofu without
                 Segoe MDL2, which is not present on every machine. -->
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button Classes="caption" WindowDecorationProperties.ElementRole="MinimizeButton"
                        Click="Minimize_Click" ToolTip.Tip="Minimize">
                    <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                          Data="M 0,5 H 10" />
                </Button>
                <Button Classes="caption" WindowDecorationProperties.ElementRole="MaximizeButton"
                        Click="Maximize_Click" ToolTip.Tip="Maximize">
                    <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                          Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                </Button>
                <Button Classes="caption close" WindowDecorationProperties.ElementRole="CloseButton"
                        Click="Close_Click" ToolTip.Tip="Close">
                    <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                          Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Body: sidebar | card grid | detail pane ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
                <!-- Collapses in the quest view, where nothing is selectable to inspect. -->
                <ColumnDefinition Width="{Binding DetailPaneWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="{StaticResource Bg1}">
                <TextBlock Grid.Row="0" Text="COLLECTION" Margin="18,16,18,8"
                           FontSize="10.5" LetterSpacing="1.6"
                           Foreground="{StaticResource GoldDim}" />

                <ListBox Grid.Row="1" Classes="sidebar" Margin="8,0"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryItem">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               FontSize="13" Foreground="{StaticResource Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                               FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar IsVisible="{Binding HasCompletion}"
                                             Classes.complete="{Binding IsComplete}"
                                             Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                                             MinHeight="3" Height="3" CornerRadius="2"
                                             Background="{StaticResource Bg3}"
                                             Foreground="{StaticResource GoldDim}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Current run card -->
                <Border Grid.Row="2" Margin="12" Padding="14,12"
                        Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="8"
                        IsVisible="{Binding HasRun}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CURRENT RUN" FontSize="10" LetterSpacing="1.6"
                                   Foreground="{StaticResource GoldDim}" />
                        <TextBlock Text="{Binding MapName}"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                   Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PositionText}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Loadout}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoadoutChip">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{StaticResource Bg3}"
                                                CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="10"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                   Foreground="{StaticResource Text}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Card grid -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBox Grid.Row="0" Classes="search" PlaceholderText="Search everything…"
                         Text="{Binding SearchText}" Margin="18,14,18,10"
                         MaxWidth="420" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="1" IsVisible="{Binding HasStatus}"
                           Text="{Binding StatusMessage}"
                           Margin="40" MaxWidth="480" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" />

                <!-- ═══ Questlines: ordered sequences, so panels rather than the card grid ═══ -->
                <ScrollViewer Grid.Row="1" Margin="12,0,12,12"
                              IsVisible="{Binding IsQuestView}">
                    <ItemsControl ItemsSource="{Binding QuestLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestLineCard">
                                <Border Width="300" Margin="6" Padding="16,14"
                                        CornerRadius="10" Background="{StaticResource Bg1}"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        Opacity="{Binding CardOpacity}">
                                    <StackPanel Spacing="10">

                                        <!-- Owner + progress -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding OwnerName}"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="15" Foreground="{StaticResource Text}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Progress}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </Grid>

                                        <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}"
                                                     Value="{Binding ProgressValue}"
                                                     MinHeight="3" Height="3" CornerRadius="2"
                                                     Foreground="{StaticResource Gold}"
                                                     Background="{StaticResource Bg3}" />

                                        <!-- Steps in narrative order -->
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QuestStepRow">
                                                  <StackPanel Margin="0,3" Opacity="{Binding RowOpacity}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Marker}"
                                                                   FontSize="10" Margin="0,0,9,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Gold}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                   FontSize="12" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Text}" />
                                                        <Border Grid.Column="2" Background="{StaticResource Bg3}"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding HasKindLabel}">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                                   FontSize="11" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasDetail}"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </Grid>
                                                    <!-- The game's own pickup line, which says where the item comes from -->
                                                    <TextBlock Text="{Binding Flavor}" FontSize="10.5"
                                                               IsVisible="{Binding HasFlavor}"
                                                               Margin="19,2,0,3" TextWrapping="Wrap"
                                                               FontStyle="Italic" LineHeight="15"
                                                               Foreground="{StaticResource GoldDim}" />
                                                  </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ListBox Grid.Row="1" Classes="cards" Margin="12,0,12,12"
                         IsVisible="{Binding ShowCardGrid}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="vm:ItemCard">
                            <StackPanel Width="128" Spacing="7" Opacity="{Binding CardOpacity}">
                                <Border Height="118" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource Bg2}">
                                    <Panel>
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="8"
                                               IsVisible="{Binding HasIcon}" />
                                        <Canvas Width="34" Height="20" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" IsVisible="{Binding !HasIcon}">
                                            <Path Stroke="{StaticResource GoldDim}" StrokeThickness="1.6"
                                                  Data="M 2,10 Q 17,-4 32,10 Q 17,24 2,10 Z" />
                                            <Ellipse Canvas.Left="14" Canvas.Top="4" Width="6" Height="13"
                                                     Fill="{StaticResource GoldDim}" />
                                        </Canvas>
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxHeight="34"
                                           Foreground="{StaticResource Text}" />
                                <!-- Counts that are the whole point of the category, e.g. Boss Kills -->
                                <TextBlock Text="{Binding SubText}" FontSize="10" TextAlignment="Center"
                                           IsVisible="{Binding HasSubText}"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:GodCard">
                            <StackPanel Width="128" Spacing="7" Opacity="{Binding CardOpacity}">
                                <Border Height="118" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource Bg2}">
                                    <Image Source="{Binding Symbol}" Stretch="Uniform" Margin="22" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding StatsLine}" FontSize="10" TextAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </Grid>

            <!-- Detail pane -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}"
                    IsVisible="{Binding !IsQuestView}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                <Panel>
                    <TextBlock Text="Select something to inspect it"
                               IsVisible="{Binding !HasDetail}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextMuted}" />

                    <ScrollViewer IsVisible="{Binding HasDetail}">
                        <StackPanel Margin="20,18" Spacing="12"
                                    DataContext="{Binding Detail}"
                                    x:DataType="vm:DetailModel">

                            <Border Height="170" CornerRadius="10" ClipToBounds="True"
                                    Background="{StaticResource Bg2}">
                                <Image Source="{Binding Icon}" Stretch="Uniform" Margin="10" />
                            </Border>

                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" LetterSpacing="1.4"
                                           Foreground="{StaticResource GoldDim}" />
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" TextWrapping="Wrap"
                                           Foreground="{StaticResource Text}" />
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding GodLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding GodSymbol}" Width="16" Height="16" />
                                    <TextBlock Text="{Binding GodLine}" FontSize="12"
                                               Foreground="{StaticResource Gold}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                           Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CounterText}" FontSize="11.5"
                                           IsVisible="{Binding CounterText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding UnlockHint}" FontSize="11.5" TextWrapping="Wrap"
                                           IsVisible="{Binding UnlockHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           FontStyle="Italic" Foreground="{StaticResource Gold}" />
                            </StackPanel>

                            <controls:RichTextPresenter RawText="{Binding RawDescription}"
                                    IsVisible="{Binding RawDescription, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                    Foreground="{StaticResource Text}" />

                            <TextBlock Text="{Binding Flavor}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding Flavor, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       FontStyle="Italic" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextMuted}" />

                            <!-- Scaling -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasScaling}">
                                <TextBlock Text="SCALING" FontSize="10" LetterSpacing="1.6"
                                           Foreground="{StaticResource GoldDim}" />
                                <ItemsControl ItemsSource="{Binding ScalingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScalingRow">
                                            <StackPanel Spacing="2" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Formula}" FontSize="12"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource Gold}" />
                                                <TextBlock Text="{Binding LevelValues}" FontSize="11"
                                                           IsVisible="{Binding LevelValues, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding Note}" FontSize="11"
                                                           IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Weapon Masteries -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasMasteries}">
                                <TextBlock Text="WEAPON MASTERIES" FontSize="10" LetterSpacing="1.6"
                                           Foreground="{StaticResource GoldDim}" />
                                <ItemsControl ItemsSource="{Binding Masteries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="gd:WeaponMastery">
                                            <StackPanel Spacing="1" Margin="0,0,0,7">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text}" />
                                                <controls:RichTextPresenter RawText="{Binding RawDescription}"
                                                        FontSize="11.5" TextWrapping="Wrap"
                                                        Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- God-only sections -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsGod}">
                                <TextBlock Text="{Binding Themes}" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding Themes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding Lore}" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding Lore, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           FontStyle="Italic" FontFamily="{StaticResource DisplayFont}"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding StatuePrompt}" FontSize="11.5" TextWrapping="Wrap"
                                           IsVisible="{Binding StatuePrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="{StaticResource TextMuted}" />

                                <ItemsControl ItemsSource="{Binding LockRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LockRuleRow">
                                            <Grid ColumnDefinitions="20,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" Text="{Binding Mark}" FontSize="12"
                                                           Foreground="{StaticResource Gold}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Rule}" FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="4" IsVisible="{Binding HasBlessings}">
                                    <TextBlock Text="BLESSINGS" FontSize="10" LetterSpacing="1.6"
                                               Foreground="{StaticResource GoldDim}" />
                                    <ItemsControl ItemsSource="{Binding Blessings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GodBlessingRow">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                                    <TextBlock Text="{Binding Dot}" FontSize="10"
                                                               Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                               Foreground="{StaticResource Text}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</Window>
