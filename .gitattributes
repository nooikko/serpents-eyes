# Normalize line endings on commit; check out native on each platform.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.targets   text
*.json      text
*.xml       text
*.axaml     text
*.md        text
*.yml       text
*.yaml      text
*.editorconfig text

# Windows-only files must stay CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Shell scripts must stay LF even when checked out on Windows.
*.sh        text eol=lf

# Binary: never diff, never touch line endings.
*.png       binary
*.jpg       binary
*.webp      binary
*.ico       binary
*.gif       binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.uasset    binary
*.ubulk     binary

# Save files back the byte-perfect round-trip tests. Git must never decide these
# are text and "fix" their line endings, which would silently corrupt fixtures.
*.sav       binary

# The tag database is generated by tools/SerpentsEyes.Extractor. Keeping it out of
# diffs and language stats stops it from dominating both.
*.g.cs                          linguist-generated=true -diff
tests/**/Fixtures/**            linguist-vendored=true
src/SerpentsEyes.App/Assets/**  linguist-vendored=true
